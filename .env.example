# Asistente IA: reglas (por defecto) | connected (Docker backend + Hugging Face + n8n; nunca pongas claves HF aquí)
EXPO_PUBLIC_AI_MODE=reglas
EXPO_PUBLIC_AI_API_URL=
# Para conectar directamente con Docker Compose local o un túnel de Google Colab:
# EXPO_PUBLIC_AI_MODE=connected
# EXPO_PUBLIC_AI_API_URL=http://localhost:8000
# EXPO_PUBLIC_COLAB_INSIGHTS_URL=http://localhost:8000/greensight/insights
# EXPO_PUBLIC_N8N_WEBHOOK_URL=http://localhost:5678/webhook/green360-mass-email

# Backend Docker / Hugging Face gratuito (se lee únicamente en el backend)
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1

# Docker n8n + SMTP (por defecto usa Mailpit local gratuito en puerto 1025 / UI 8025)
N8N_ENCRYPTION_KEY=green360-dev-encryption-key-change-in-prod-32c
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SSL=false
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=operaciones@greenservices.co
