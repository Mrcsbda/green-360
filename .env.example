# Firebase (Configuración del proyecto → Tus apps → Web). Son identificadores públicos; la seguridad está en firestore.rules + Auth.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Permite iniciar sesión con usuario corto: operativo1 → operativo1@<dominio>
EXPO_PUBLIC_LOGIN_EMAIL_DOMAIN=

# Asistente IA: reglas (por defecto) | connected (backend propio; nunca pongas claves de IA aquí)
EXPO_PUBLIC_AI_MODE=reglas
EXPO_PUBLIC_AI_API_URL=
