{
  "id": "green360MassEmailWf",
  "name": "Green 360 - Envio Masivo MoE",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "green360-mass-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-mass-email",
      "name": "Webhook Campana Green 360",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "green360-mass-email-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst campaign = body.campaign || {};\nconst recipients = Array.isArray(body.recipients) ? body.recipients : [];\nconst sender = campaign.sender || 'operaciones@greenservices.co';\n\nif (!recipients.length) {\n  return [{ json: { skip: true, message: 'Sin destinatarios validos' } }];\n}\n\nreturn recipients.map((r) => ({\n  json: {\n    skip: false,\n    id: r.id || '',\n    empresa: r.empresa || 'Cliente Green Services',\n    email: r.email,\n    ciudad: r.ciudad || 'Colombia',\n    asunto: r.asunto || campaign.asuntoBase || 'Green Services · Actualizacion comercial',\n    cuerpo: r.cuerpo || '',\n    sender,\n    expertoMoE: campaign.expertoMoE || 'MoE GreenSight',\n    productoFoco: campaign.productoFoco || 'Servicios documentales'\n  }\n}));"
      },
      "id": "code-prep-recipients",
      "name": "Preparar Destinatarios MoE",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.skip }}",
              "value2": false
            }
          ]
        }
      },
      "id": "if-has-recipients",
      "name": "Tiene Destinatarios?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.sender }}",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.asunto }}",
        "emailFormat": "text",
        "text": "={{ $json.cuerpo }}",
        "options": {}
      },
      "id": "smtp-send-email",
      "name": "Enviar Correo Masivo SMTP",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [940, 220],
      "credentials": {
        "smtp": {
          "id": "green360-smtp",
          "name": "Green 360 SMTP"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn [{\n  json: {\n    ok: true,\n    workflow: 'green360-mass-email',\n    sentCount: items.length,\n    timestamp: new Date().toISOString(),\n    status: 'Correos enviados correctamente via n8n'\n  }\n}];"
      },
      "id": "code-summary-ok",
      "name": "Resumen de Envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 220]
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Responder al Chat",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1400, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": false, \"sentCount\": 0, \"message\": \"No llegaron destinatarios validos al webhook de n8n\" } }}",
        "options": {}
      },
      "id": "respond-empty",
      "name": "Responder Sin Destinatarios",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [940, 420]
    }
  ],
  "connections": {
    "Webhook Campana Green 360": {
      "main": [[{ "node": "Preparar Destinatarios MoE", "type": "main", "index": 0 }]]
    },
    "Preparar Destinatarios MoE": {
      "main": [[{ "node": "Tiene Destinatarios?", "type": "main", "index": 0 }]]
    },
    "Tiene Destinatarios?": {
      "main": [
        [{ "node": "Enviar Correo Masivo SMTP", "type": "main", "index": 0 }],
        [{ "node": "Responder Sin Destinatarios", "type": "main", "index": 0 }]
      ]
    },
    "Enviar Correo Masivo SMTP": {
      "main": [[{ "node": "Resumen de Envio", "type": "main", "index": 0 }]]
    },
    "Resumen de Envio": {
      "main": [[{ "node": "Responder al Chat", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
